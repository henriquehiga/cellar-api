# Dependencies (will be installed inside the container)
node_modules

# Git and OS-specific files
.git
.gitignore
.DS_Store

# Environment files
.env
.env.*
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build artifacts and logs
build
dist
logs
*.log

# Docker specific files that shouldn't be copied into the final image
Dockerfile
docker-compose*.yml
.dockerignore
